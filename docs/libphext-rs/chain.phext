item+ function src/phext.rs :: merge :: pub fn merge(left: &str, right: &str) -> String { :: ---------------------------------------------------------------------------------------------------------- @fn merge  combines `left` and `right` into a new phext document, with content merged on a per-scroll basis ---------------------------------------------------------------------------------------------------------- :: doc comment :: 978 :: 1
item+ function src/phext.rs :: normalize :: pub fn normalize(input: &str) -> String { :: ---------------------------------------------------------------------------------------------------------- :: doc comment :: 1198 :: 1
item+ function src/phext.rs :: parse_chains :: pub fn parse_chains(input: &str) -> Vec<Chain> { :: ---------------------------------------------------------------------------------------------------------- @fn parse_chains  splits a stream into its chains. CHAIN_BREAK separates the member phexts of a chain; CHAIN_CLOSE terminates a chain, and whatever follows it opens the next one — so one stream may hold many chains. The stream's final chain is closed only when the stream ends with CHAIN_CLOSE.  Splitting follows `split_on` semantics, so empty members and empty chains are preserved exactly: parse and serialize are byte-exact inverses for every stream. ---------------------------------------------------------------------------------------------------------- :: doc comment :: 1257 :: 1
item+ function src/phext.rs :: parse_point_address :: pub fn parse_point_address(address: &str) -> Option<PointAddress> { :: ------------------------------------------------------------------------------------------------------ @fn parse_point_address  parses a v0.6.1 point address: "[$N:]<coordinate>[@<line>,<column>[+<offsetChars>]]". Returns None on any malformed input: universe 0, a coordinate component below 1, a line or column below 1, a sign anywhere, or trailing structure. "$1:" is accepted on input; the canonical Display form never emits it. ------------------------------------------------------------------------------------------------------ :: doc comment :: 1646 :: 1
item+ function src/phext.rs :: parse_range_address :: pub fn parse_range_address(address: &str) -> Option<RangeAddress> { :: ------------------------------------------------------------------------------------------------------ @fn parse_range_address  parses a v0.6.1 range address: exactly two point addresses joined by one hyphen. The endpoints are normalized to ascending order (direction is discarded, per the ratified spec). Range endpoints may not carry a "+offset" — the offset form never takes a second endpoint. Returns None on malformed input. ------------------------------------------------------------------------------------------------------ :: doc comment :: 1704 :: 1
item+ function src/phext.rs :: parse_universe_address :: pub fn parse_universe_address(address: &str) -> Option<(usize, Coordinate)> { :: Function parse_universe_address takes address: &str and gives back Option<(usize, Coordinate)>. :: signature :: 1521 :: 0
item+ function src/phext.rs :: resolve_range :: pub fn resolve_range(&self, range: &RangeAddress) -> Option<Vec<(usize, Coordinate, String)>> { :: ------------------------------------------------------------------------------------------------------ @fn resolve_range  resolves a range against this chain into per-scroll segments: (universe, coordinate, segment text) in ascending order. Middle scrolls contribute their whole text; the endpoint scrolls contribute from/to their endpoint boundaries (an endpoint without "@" contributes its whole scroll). None when either endpoint fails to resolve — an out-of-range endpoint is an error, never a clamp. ------------------------------------------------------------------------------------------------------ :: doc comment :: 1781 :: 1
