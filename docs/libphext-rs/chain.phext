item+ struct src/phext.rs :: Coordinate :: pub struct Coordinate { :: ---------------------------------------------------------------------------------------------------------- @struct Coordinate  provides access to a default-initialized coordinate at 1.1.1/1.1.1/1.1.1  phext coordinates are formed along a 9-dimensional hierarchy with three main arms of the form z3.z2.z1/y3.y2.y1.x3.x2.x1 where:  Z - this arm contains the library (z3), shelf (z2), and series (z1) dimensions Y - this arm contains the collection (y3), volume (y2), and book (y1) dimensions X - this arm contains the chapter (x3), section (x2), and scroll (x1) dimensions ---------------------------------------------------------------------------------------------------------- :: doc comment
item+ function src/phext.rs :: Coordinate::validate_coordinate :: pub fn validate_coordinate(&self) -> bool { :: ---------------------------------------------------------------------------------------------------------- @fn validate_coordinate  determines if coord points to a valid phext address  @param coord: the coordinate to reset ---------------------------------------------------------------------------------------------------------- :: doc comment
item+ const src/phext.rs :: LIBRARY_BREAK :: pub const LIBRARY_BREAK: char = '\x01'; // 11th dimension - replaces start of header :: A fixed value named LIBRARY_BREAK, set to '\x01'; // 11th dimension - replaces start of header. :: signature
item+ const src/phext.rs :: LINE_BREAK :: pub const LINE_BREAK: char = '\x0A'; // same as plain text \o/ :: A fixed value named LINE_BREAK, set to '\x0A'; // same as plain text \o/. :: signature
item+ const src/phext.rs :: MORE_COWBELL :: pub const MORE_COWBELL: char = '\x07'; // i've got a fever, and the only prescription...is more cowbell! :: A fixed value named MORE_COWBELL, set to '\x07'; // i've got a fever, and the only prescription...is . :: signature
