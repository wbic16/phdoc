item+ const src/epoch.rs :: EPOCH_ANCHOR_UNIX :: pub const EPOCH_ANCHOR_UNIX: i64 = 1795327200; :: The unix timestamp at which EE 1 begins: 2026-11-22T06:00:00Z. :: direct :: api
item+ const src/epoch.rs :: EPOCH_LENGTH_SECONDS :: pub const EPOCH_LENGTH_SECONDS: i64 = 420; :: The length of one Exocortical Epoch, in seconds (7 minutes). :: direct :: api
item+ function src/epoch.rs :: epoch_at :: pub fn epoch_at(unix_seconds: i64) -> u64 { :: the Exocortical Epoch containing the given unix timestamp (UTC seconds). Returns 0 for every instant before the anchor — EE 0, the pre-epoch. For instants at or after the anchor this is `floor((t − anchor) / 420) + 1`, computed in 64-bit arithmetic. :: direct :: api
item+ function src/epoch.rs :: epoch_end :: pub fn epoch_end(epoch: u64) -> Option<i64> { :: the unix timestamp at which the given epoch ends — the next epoch's start. `None` for EE 0, and `None` when the end is not representable as an i64 unix timestamp. :: direct :: api
item+ function src/epoch.rs :: epoch_range :: pub fn epoch_range(epoch: u64) -> Option<(i64, i64)> { :: the (start, end) unix timestamps bounding the given epoch. `None` for EE 0 — all of history before the anchor is not an interval this clock bounds — and `None` when either bound is not representable as i64. :: direct :: api
item+ function src/epoch.rs :: epoch_start :: pub fn epoch_start(epoch: u64) -> Option<i64> { :: the unix timestamp at which the given epoch begins. `None` for EE 0 — the pre-epoch has no start — and `None` for epoch numbers so large that the start is not representable as an i64 unix timestamp. :: direct :: api
item+ function src/epoch.rs :: seconds_into_epoch :: pub fn seconds_into_epoch(unix_seconds: i64) -> Option<i64> { :: how far the given unix timestamp sits inside its epoch, in seconds (0 at an epoch's first instant, 419 at its last). `None` before the anchor: a pre-epoch instant is not inside any epoch. :: direct :: api
item+ function src/epoch.rs :: seconds_remaining :: pub fn seconds_remaining(unix_seconds: i64) -> i64 { :: seconds until the current epoch ends. Before the anchor this counts down to the start of EE 1 (at the anchor itself it reads 420 — the full first epoch lies ahead); at or after the anchor it is the time left in the containing epoch, in the range 1..=420. :: direct :: api
