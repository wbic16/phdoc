item+ function src/phext.rs :: Chain::resolve_point :: pub fn resolve_point(&self, point: &PointAddress) -> Option<(usize, Coordinate, usize)> { :: ------------------------------------------------------------------------------------------------------ @fn resolve_point  resolves a point address against this chain: (universe, coordinate, character offset within the scroll). A point without "@" resolves to offset 0 of its scroll. None when the universe or scroll is absent or the position is out of range — never clamps. ------------------------------------------------------------------------------------------------------ :: doc comment :: 1734 :: 1
item+ function src/phext.rs :: fetch_point :: pub fn fetch_point(&self, address: &str) -> String { :: ------------------------------------------------------------------------------------------------------ @fn fetch_point  fetches a point address string. A bare point is a caret: it fetches the empty string. The offset form fetches the selected characters: from the point, forward `offset` characters (scalars) within the scroll, terminating at the scroll boundary. Any parse or resolution failure fetches the empty string, as Chain::fetch does. ------------------------------------------------------------------------------------------------------ :: doc comment :: 1752 :: 1
item+ function src/phext.rs :: fetch_range :: pub fn fetch_range(&self, address: &str) -> String { :: ------------------------------------------------------------------------------------------------------ @fn fetch_range  fetches a range address string: the spanned text with phext structure bytes preserved — the covered segments re-assembled at their coordinates into a phext (chain) fragment (scroll breaks between covered scrolls inside a universe, CHAIN_BREAK between universes, never a trailing CHAIN_CLOSE: a fragment is an excerpt, not a terminated chain), so the result round-trips as a phext fragment. Empty segments contribute nothing. Any parse or resolution failure fetches the empty string, as Chain::fetch does. ------------------------------------------------------------------------------------------------------ :: doc comment :: 1811 :: 1
item+ function src/phext.rs :: parse_point_address :: pub fn parse_point_address(address: &str) -> Option<PointAddress> { :: ------------------------------------------------------------------------------------------------------ @fn parse_point_address  parses a v0.6.1 point address: "[$N:]<coordinate>[@<line>,<column>[+<offsetChars>]]". Returns None on any malformed input: universe 0, a coordinate component below 1, a line or column below 1, a sign anywhere, or trailing structure. "$1:" is accepted on input; the canonical Display form never emits it. ------------------------------------------------------------------------------------------------------ :: doc comment :: 1634 :: 1
item+ function src/phext.rs :: parse_range_address :: pub fn parse_range_address(address: &str) -> Option<RangeAddress> { :: ------------------------------------------------------------------------------------------------------ @fn parse_range_address  parses a v0.6.1 range address: exactly two point addresses joined by one hyphen. The endpoints are normalized to ascending order (direction is discarded, per the ratified spec). Range endpoints may not carry a "+offset" — the offset form never takes a second endpoint. Returns None on malformed input. ------------------------------------------------------------------------------------------------------ :: doc comment :: 1692 :: 1
item+ function src/phext.rs :: resolve_range :: pub fn resolve_range(&self, range: &RangeAddress) -> Option<Vec<(usize, Coordinate, String)>> { :: ------------------------------------------------------------------------------------------------------ @fn resolve_range  resolves a range against this chain into per-scroll segments: (universe, coordinate, segment text) in ascending order. Middle scrolls contribute their whole text; the endpoint scrolls contribute from/to their endpoint boundaries (an endpoint without "@" contributes its whole scroll). None when either endpoint fails to resolve — an out-of-range endpoint is an error, never a clamp. ------------------------------------------------------------------------------------------------------ :: doc comment :: 1769 :: 1
