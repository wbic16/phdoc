item+ const src/binary.rs :: BINARY_SCROLL_HEADER :: pub const BINARY_SCROLL_HEADER: &str = "phext-binary:1:base64"; :: The first (and only header) line of a binary scroll, without its line break. :: doc comment :: 42 :: 1
item+ function src/binary.rs :: decode_scroll :: pub fn decode_scroll(scroll: &str) -> Option<Vec<u8>> { :: ---------------------------------------------------------------------------------------------------------- @fn decode_scroll  decodes a binary scroll back to its raw bytes. Returns None when the scroll is not a binary scroll, or when its body is not strict base64. ---------------------------------------------------------------------------------------------------------- :: doc comment :: 75 :: 1
item+ function src/binary.rs :: encode_scroll :: pub fn encode_scroll(payload: &[u8]) -> String { :: ---------------------------------------------------------------------------------------------------------- @fn encode_scroll  encodes raw bytes as a binary scroll (header line + base64 body) ---------------------------------------------------------------------------------------------------------- :: doc comment :: 62 :: 1
item+ function src/binary.rs :: fetch_binary :: pub fn fetch_binary(input: &str, target: Coordinate) -> Vec<u8> { :: ---------------------------------------------------------------------------------------------------------- @fn fetch_binary  retrieves the bytes held at `target`. A well-formed binary scroll decodes to its payload. Any other scroll — plain text, a malformed binary scroll, or no scroll at all — yields the scroll's own UTF-8 bytes (empty when the coordinate is unoccupied), mirroring how `phext::fetch` returns "" there. This function is total: it never panics and never loses scroll content. ---------------------------------------------------------------------------------------------------------- :: doc comment :: 110 :: 1
item+ function src/binary.rs :: ingest :: pub fn ingest(bytes: &[u8]) -> String { :: ---------------------------------------------------------------------------------------------------------- @fn ingest  ingests an externally supplied phext byte stream. Every scroll is observed as raw bytes: valid UTF-8 scrolls pass through verbatim, and any scroll whose bytes are not valid UTF-8 is stored as a binary scroll holding the base64 of the exact observed bytes (the ingestion rule), so `fetch_binary` at its coordinate returns the original bytes exactly. Never rejects, never panics. The result is the canonical serialization (the same normal form as `phext::implode` of `phext::explode`). ---------------------------------------------------------------------------------------------------------- :: doc comment :: 227 :: 1
item+ function src/binary.rs :: insert_binary :: pub fn insert_binary(input: String, location: Coordinate, payload: &[u8]) -> String { :: ---------------------------------------------------------------------------------------------------------- @fn insert_binary  stores `payload` at `location` as a binary scroll, unconditionally: the caller has declared this scroll binary, even if the bytes happen to be valid UTF-8. ---------------------------------------------------------------------------------------------------------- :: doc comment :: 87 :: 1
item+ function src/binary.rs :: insert_bytes :: pub fn insert_bytes(input: String, location: Coordinate, payload: &[u8]) -> String { :: ---------------------------------------------------------------------------------------------------------- @fn insert_bytes  byte-oriented insert: stores `payload` at `location` under the ingestion rule (UTF-8 as text, non-UTF-8 as a base64-verbatim binary scroll). ---------------------------------------------------------------------------------------------------------- :: doc comment :: 134 :: 1
item+ function src/binary.rs :: is_binary_scroll :: pub fn is_binary_scroll(scroll: &str) -> bool { :: ---------------------------------------------------------------------------------------------------------- @fn is_binary_scroll  true when `scroll` carries the binary scroll header. Decoding success is a separate question — see `decode_scroll`. ---------------------------------------------------------------------------------------------------------- :: doc comment :: 53 :: 1
item+ function src/binary.rs :: phokenize_bytes :: pub fn phokenize_bytes(input: &[u8]) -> Vec<(Coordinate, Vec<u8>)> { :: ---------------------------------------------------------------------------------------------------------- @fn phokenize_bytes  the byte-level twin of `phext::phokenize`: walks a raw byte stream and returns each scroll's coordinate and raw bytes, with identical segmentation. Dimension-break bytes are ASCII, so byte offsets are exact; scroll bodies are returned uninterpreted, valid UTF-8 or not. ---------------------------------------------------------------------------------------------------------- :: doc comment :: 180 :: 1
item+ function src/binary.rs :: replace_binary :: pub fn replace_binary(input: &str, location: Coordinate, payload: &[u8]) -> String { :: ---------------------------------------------------------------------------------------------------------- @fn replace_binary  replaces the scroll at `location` with `payload`, stored as a binary scroll (see `insert_binary`). ---------------------------------------------------------------------------------------------------------- :: doc comment :: 97 :: 1
item+ function src/binary.rs :: replace_bytes :: pub fn replace_bytes(input: &str, location: Coordinate, payload: &[u8]) -> String { :: ---------------------------------------------------------------------------------------------------------- @fn replace_bytes  byte-oriented replace: stores `payload` at `location` under the ingestion rule (UTF-8 as text, non-UTF-8 as a base64-verbatim binary scroll). ---------------------------------------------------------------------------------------------------------- :: doc comment :: 144 :: 1
