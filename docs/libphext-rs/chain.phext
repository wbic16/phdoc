item+ function src/phext.rs :: Chain::fetch_point :: pub fn fetch_point(&self, address: &str) -> String { :: fetches a point address string. A bare point is a caret: it fetches the empty string. The offset form fetches the selected characters: from the point, forward `offset` characters (scalars) within the scroll, terminating at the scroll boundary. Any parse or resolution failure fetches the empty string, as Chain::fetch does. :: direct :: api
item+ function src/phext.rs :: Chain::fetch_range :: pub fn fetch_range(&self, address: &str) -> String { :: fetches a range address string: the spanned text with phext structure bytes preserved — the covered segments re-assembled at their coordinates into a phext (chain) fragment (scroll breaks between covered scrolls inside a universe, CHAIN_BREAK between universes, never a trailing CHAIN_CLOSE: a fragment is an excerpt, not a terminated chain), so the result round-trips as a phext fragment. Empty segments contribute nothing. Any parse or resolution failure fetches the empty string, as Chain::fetch does. :: direct :: api
item+ function src/phext.rs :: Chain::resolve_point :: pub fn resolve_point(&self, point: &PointAddress) -> Option<(usize, Coordinate, usize)> { :: resolves a point address against this chain: (universe, coordinate, character offset within the scroll). A point without "@" resolves to offset 0 of its scroll. None when the universe or scroll is absent or the position is out of range — never clamps. :: direct :: api
item+ function src/phext.rs :: Chain::resolve_range :: pub fn resolve_range(&self, range: &RangeAddress) -> Option<Vec<(usize, Coordinate, String)>> { :: resolves a range against this chain into per-scroll segments: (universe, coordinate, segment text) in ascending order. Middle scrolls contribute their whole text; the endpoint scrolls contribute from/to their endpoint boundaries (an endpoint without "@" contributes its whole scroll). None when either endpoint fails to resolve — an out-of-range endpoint is an error, never a clamp. :: direct :: api
item+ struct src/phext.rs :: PointAddress :: pub struct PointAddress { :: One parsed point address: universe (1-based; 1 when the "$N:" prefix is absent), the 9D coordinate, an optional caret position, and an optional forward offset in characters. :: direct :: api
item+ struct src/phext.rs :: RangeAddress :: pub struct RangeAddress { :: A parsed range: two point endpoints, normalized to ascending order at parse time. :: direct :: api
item+ struct src/phext.rs :: ScrollPosition :: pub struct ScrollPosition { :: A caret boundary inside one scroll: 1-based line and column (see the section note above). :: direct :: api
item+ function src/phext.rs :: parse_point_address :: pub fn parse_point_address(address: &str) -> Option<PointAddress> { :: parses a v0.6.1 point address: "[$N:]<coordinate>[@<line>,<column>[+<offsetChars>]]". Returns None on any malformed input: universe 0, a coordinate component below 1, a line or column below 1, a sign anywhere, or trailing structure. "$1:" is accepted on input; the canonical Display form never emits it. :: direct :: api
item+ function src/phext.rs :: parse_range_address :: pub fn parse_range_address(address: &str) -> Option<RangeAddress> { :: parses a v0.6.1 range address: exactly two point addresses joined by one hyphen. The endpoints are normalized to ascending order (direction is discarded, per the ratified spec). Range endpoints may not carry a "+offset" — the offset form never takes a second endpoint. Returns None on malformed input. :: direct :: api
