item+ type src/builder.rs :: NodeId :: pub type NodeId = (String, String); :: A node's identity: (home phext, coordinate) — nothing else (SPEC §2.1). :: direct :: api
item+ struct src/builder.rs :: RegistryEntry :: pub struct RegistryEntry { :: One assay-registry entry (SPEC §5.1): one per claim-bearing unit. :: direct :: api
item+ function src/builder.rs :: build :: pub fn build(homes: &[(String, String)]) -> Graph { :: Fold a federation of phexts into a graph. `homes` is (home name, phext text) pairs. A scroll is a node scroll iff its first content line opens with `node · `; every other scroll is material the graph sits beside (SPEC §2.5), counted but not parsed. :: direct :: api
item+ function src/builder.rs :: render_index :: pub fn render_index(g: &Graph, stamp: &str) -> String { :: Render the generated index as a phext (SPEC §2.3): a Home scroll with the rollup and the builder's stamp, and one scroll per derived surface. `stamp` is the build's hop stamp (an ISO datetime string). :: direct :: api
item+ flag src/main.rs :: --out :: flag --out :: A command line flag, --out. It is read by the program when the user passes it. :: inferred :: api
item+ flag src/main.rs :: --stamp :: flag --stamp :: A command line flag, --stamp. It is read by the program when the user passes it. :: inferred :: api
item+ entry-point src/main.rs :: main :: fn main() -> ExitCode { :: The entry point: the program starts here. It reads the command line and runs the command the user named. :: inferred :: api
item+ enum src/schema.rs :: Basis :: pub enum Basis { :: Claim bases (SPEC §5.1). The basis constrains which statuses a claim-bearing unit may take — see [`status_legal_for_basis`]. :: direct :: api
item+ function src/schema.rs :: Basis::name :: pub fn name(&self) -> &'static str { :: Function Basis::name takes no inputs beyond the value it is called on. It gives back &'static str. :: inferred :: api
item+ function src/schema.rs :: Basis::parse :: pub fn parse(s: &str) -> Option<Basis> { :: Function Basis::parse takes s: &str. It gives back Option<Basis>. :: inferred :: api
item+ const src/schema.rs :: CLAIM_BEARING_ALLOWED :: pub const CLAIM_BEARING_ALLOWED: [&str; 1] = ["derived_from"]; :: A fixed value named CLAIM_BEARING_ALLOWED, set to ["derived_from"]. :: inferred :: api
item+ const src/schema.rs :: CLAIM_BEARING_REQUIRED :: pub const CLAIM_BEARING_REQUIRED: [&str; 2] = ["asserts", "contradicts"]; :: Edge types whose existence asserts something about the world (SPEC §5.1). A claim-bearing edge MUST carry exactly one status/basis pair and a real evidence pointer. `derived_from` MAY carry the pair (a claim's provenance is assayable); all other types MUST NOT carry it — a structural edge omits the pair rather than decorating itself with an assay it does not need (SPEC §2.2). :: direct :: api
item+ const src/schema.rs :: EDGE_TYPES :: pub const EDGE_TYPES: [&str; 9] = [ :: Edge types (SPEC §1.3). Every type below already exists in a seed corpus. `made` is NOT an edge type: it is attribution recorded on a work's scroll (SPEC §1.2), because there is no person node for the edge to leave from. :: direct :: api
item+ const src/schema.rs :: NODE_KINDS :: pub const NODE_KINDS: [&str; 8] = [ :: Node kinds (SPEC §1.2). Eight kinds, each supplied by a seed corpus. There is deliberately no `person` kind: KGOAT is for ideas, not people (D6, SPEC §5.2). A scroll claiming kind `person` is non-conformant. :: direct :: api
item+ enum src/schema.rs :: Status :: pub enum Status { :: Claim statuses (SPEC §5.1), inherited from the Minimum Viable Oracle discipline whole. :: direct :: api
item+ function src/schema.rs :: Status::name :: pub fn name(&self) -> &'static str { :: Function Status::name takes no inputs beyond the value it is called on. It gives back &'static str. :: inferred :: api
item+ function src/schema.rs :: Status::parse :: pub fn parse(s: &str) -> Option<Status> { :: Function Status::parse takes s: &str. It gives back Option<Status>. :: inferred :: api
item+ function src/schema.rs :: assay_permitted :: pub fn assay_permitted(ty: &str) -> bool { :: May an edge of type `ty` carry a status/basis pair at all? :: direct :: api
item+ function src/schema.rs :: assay_required :: pub fn assay_required(ty: &str) -> bool { :: Does an edge of type `ty` require a status/basis pair? :: direct :: api
item+ function src/schema.rs :: coordinate_well_formed :: pub fn coordinate_well_formed(s: &str) -> bool { :: Is `s` a well-formed phext coordinate string (`a.b.c/d.e.f/g.h.i`, each component ≥ 1)? Coordinates are content, not keys (SPEC §2.1); this checks form only. :: direct :: api
item+ function src/schema.rs :: hop_stamp_well_formed :: pub fn hop_stamp_well_formed(s: &str) -> bool { :: Is `s` a well-formed hop stamp (SPEC §2.2): an ISO date `YYYY-MM-DD`, optionally followed by `T` and a time. The graph records when *it* learned a thing; hop stamps are the graph's own history (SPEC §5.2). :: direct :: api
item+ function src/schema.rs :: is_edge_type :: pub fn is_edge_type(ty: &str) -> bool { :: Is `ty` a v1 edge type? :: direct :: api
item+ function src/schema.rs :: is_node_kind :: pub fn is_node_kind(kind: &str) -> bool { :: Is `kind` a v1 node kind? :: direct :: api
item+ function src/schema.rs :: max_weight :: pub fn max_weight(ty: &str) -> u8 { :: Maximum weight for an edge type. Weights are ordinal 0–3 (SPEC §1.3); `mentions` — the weakest form — is capped at 1. :: direct :: api
item+ function src/schema.rs :: status_legal_for_basis :: pub fn status_legal_for_basis(status: Status, basis: Basis) -> bool { :: The basis→status legality table (SPEC §5.1, MVO discipline): no VERIFIED receipt, no True; a refuted claim is False/REFUTED; attributed and open material is believed by no one yet (Unknown); a construction is Fiction. :: direct :: api
item+ function src/schema.rs :: transition_legal :: pub fn transition_legal(from: Status, to: Status) -> bool { :: Legal status transitions (SPEC §2.4, the MVO legal edges). Every transition is recorded as a history event with its evidence pointer. There is no transition into True without a receipt, and Fiction never goes directly to True. :: direct :: api
item+ struct src/scroll.rs :: Assay :: pub struct Assay { :: A status/basis/evidence triple — the assay record of a claim-bearing unit (SPEC §5.1) — with the hop stamp of when the graph recorded it. :: direct :: api
item+ struct src/scroll.rs :: Edge :: pub struct Edge { :: One stored outbound edge (SPEC §2.2). Edges are stored exactly once, in the source node's scroll; inbound edges are derived by the builder. :: direct :: api
item+ struct src/scroll.rs :: Node :: pub struct Node { :: A parsed node scroll. Identity is placement: `coord` is the scroll's coordinate inside its home phext, supplied by the caller (SPEC §2.1). :: direct :: api
item+ struct src/scroll.rs :: Transition :: pub struct Transition { :: A recorded status transition (SPEC §2.4). History is kept, not overwritten; the present is the builder's fold over it. :: direct :: api
item+ function src/scroll.rs :: parse_node :: pub fn parse_node(coord: &str, text: &str) -> Result<Node, Vec<String>> { :: Parse one node scroll. `coord` is the scroll's coordinate in its home phext. On failure, returns every violation found in the scroll. :: direct :: api
