item~ struct src/mmap.rs :: MappedLattice :: pub struct MappedLattice { :: A memory-mapped phext document with copy-on-write editing. The document may be a chain (a multiverse): several member phexts — universes — in one file. All read/write methods operate on the active* universe (see `universe` / `set_universe`); a plain phext is a chain of one universe and behaves exactly as it always has. :: direct :: api
item+ function src/mmap.rs :: MappedLattice::is_chain :: pub fn is_chain(&self) -> bool { :: True when this file is a chain: more structure than a plain phext's single unclosed member. :: direct :: api
item+ function src/mmap.rs :: MappedLattice::member_stats :: pub fn member_stats(&self) -> Vec<(usize, usize)> { :: Per-universe (scroll count, content bytes), in universe order. :: direct :: api
item~ function src/mmap.rs :: MappedLattice::open_with_index :: pub fn open_with_index<P: AsRef<Path>>(path: P, index: LatticeIndex) -> io::Result<MappedLattice> { :: Open a phext file with an index built elsewhere (e.g. loaded from a `sidecar`), skipping the O(n) scan. Fails if the index was built for a buffer of a different length. A chain-class file ignores the supplied index — a persisted span table describes one universe, not a chain — and is opened with a fresh scan instead. :: direct :: api
item+ function src/mmap.rs :: MappedLattice::read_scroll_bytes_in :: pub fn read_scroll_bytes_in(&self, universe: usize, coord: &Coordinate) -> Option<Vec<u8>> { :: A scroll's exact stored bytes in `universe` (numbered from 1), without switching the active universe. The overlay applies only when `universe` is the active one. :: direct :: api
item+ function src/mmap.rs :: MappedLattice::read_scroll_in :: pub fn read_scroll_in(&self, universe: usize, coord: &Coordinate) -> Option<String> { :: A scroll's content in `universe` (numbered from 1), without switching the active universe. :: direct :: api
item+ function src/mmap.rs :: MappedLattice::set_universe :: pub fn set_universe(&mut self, universe: usize) -> io::Result<()> { :: Make `universe` (numbered from 1) the active universe. Refused while the overlay holds unsaved edits — an edit never straddles a switch — and when the universe is out of range. :: direct :: api
item+ function src/mmap.rs :: MappedLattice::universe :: pub fn universe(&self) -> usize { :: The active universe, numbered from 1. :: direct :: api
item+ function src/mmap.rs :: MappedLattice::universe_count :: pub fn universe_count(&self) -> usize { :: How many universes (member phexts) this file holds. A plain phext holds exactly one. :: direct :: api
