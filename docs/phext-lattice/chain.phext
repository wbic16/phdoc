commit fe69b7490969ce49d969736788faaa9da9c93159
parent fa8ac0dce50fc833ba9d1655fc3f98f0b3b3bee8
author Theia <theia@mirrorborn.us>
date 1794286840 2026-11-10
dep~ Cargo.toml :: libphext :: 0.4.0 -> 0.5.0
item+ const src/media.rs :: AVIF :: pub const AVIF: ImageKind = ImageKind { content_type: "image/avif", extension: "avif" }; :: A fixed value named AVIF, set to ImageKind { content_type: "image/avif", extension: "avif" }. :: signature
item+ const src/media.rs :: GIF :: pub const GIF: ImageKind = ImageKind { content_type: "image/gif", extension: "gif" }; :: A fixed value named GIF, set to ImageKind { content_type: "image/gif", extension: "gif" }. :: signature
item+ struct src/media.rs :: ImageKind :: pub struct ImageKind { :: A raster image format the editor accepts, identified by magic bytes. :: doc comment
item+ const src/media.rs :: JPEG :: pub const JPEG: ImageKind = ImageKind { content_type: "image/jpeg", extension: "jpg" }; :: A fixed value named JPEG, set to ImageKind { content_type: "image/jpeg", extension: "jpg" }. :: signature
item+ const src/media.rs :: PNG :: pub const PNG: ImageKind = ImageKind { content_type: "image/png", extension: "png" }; :: A fixed value named PNG, set to ImageKind { content_type: "image/png", extension: "png" }. :: signature
item+ const src/media.rs :: WEBP :: pub const WEBP: ImageKind = ImageKind { content_type: "image/webp", extension: "webp" }; :: A fixed value named WEBP, set to ImageKind { content_type: "image/webp", extension: "webp" }. :: signature
item+ function src/media.rs :: is_well_formed_binary_scroll :: pub fn is_well_formed_binary_scroll(stored: &str) -> bool { :: True when `stored` is a well-formed binary scroll: it carries the canonical header and its body is strict base64 (an empty payload — header plus newline, nothing after — is well-formed). A header-prefixed scroll whose body is not strict base64 is malformed: by the format's fetch rule it is text, fetched verbatim, and the text write path may still edit it. Only well-formed binary scrolls are protected from text writes. :: doc comment
item+ function src/media.rs :: media_metadata_coord :: pub fn media_metadata_coord(slot: usize) -> Coordinate { :: Where slot `slot`'s metadata scroll (JSON text) lives: 9.9.9/9.9.9/1.2.n. :: doc comment
item+ function src/media.rs :: media_payload_coord :: pub fn media_payload_coord(slot: usize) -> Coordinate { :: Where slot `slot`'s image payload (a binary scroll) lives: 9.9.9/9.9.9/1.1.n. :: doc comment
item+ function src/media.rs :: media_slot_of :: pub fn media_slot_of(coord: &Coordinate) -> Option<usize> { :: The media slot a coordinate belongs to, if it is a media payload coordinate (9.9.9/9.9.9/1.1.n). :: doc comment
item+ function src/media.rs :: sniff_image :: pub fn sniff_image(bytes: &[u8]) -> Option<ImageKind> { :: Identify an image payload by its magic bytes — never by a file name or a client-claimed type. SVG is deliberately absent: it is a scriptable document format, not a raster, and is never accepted or served by the image path, so there is no stored-XSS surface to make inert. :: doc comment
item+ function src/mmap.rs :: fetch_binary :: pub fn fetch_binary(&self, coord: &Coordinate) -> Vec<u8> { :: The payload a fetch of this scroll returns, mirroring `libphext::binary::fetch_binary` exactly: a well-formed binary scroll decodes to its payload; any other scroll (plain text, malformed binary, unoccupied) yields its own stored bytes verbatim — empty when the coordinate holds no scroll. Total: never fails, never panics. :: doc comment
item+ function src/mmap.rs :: read_scroll_bytes :: pub fn read_scroll_bytes(&self, coord: &Coordinate) -> Option<Vec<u8>> { :: The scroll's exact stored bytes: the overlay version if edited, otherwise the mmap span, uninterpreted. This is the raw layer the binary-scroll support is built on — a binary scroll's stored form is text (header + base64), but payloads are recovered from these bytes without any lossy conversion. :: doc comment
item+ function src/mmap.rs :: write_binary :: pub fn write_binary(&mut self, coord: Coordinate, payload: &[u8]) { :: Store `payload` at `coord` as a canonical binary scroll (header + base64 of the exact bytes), whatever the payload holds. :: doc comment
item+ function src/mmap.rs :: write_bytes :: pub fn write_bytes(&mut self, coord: Coordinate, payload: &[u8]) { :: Store `payload` at `coord` under the format's ingestion rule (libphext's `stored_form`, behind `insert_bytes`/`replace_bytes`): valid UTF-8 is stored as ordinary text; anything else becomes a binary scroll holding the exact bytes. Ingestion never rejects a payload. :: doc comment
item~ function src/mmap.rs :: write_scroll :: pub fn write_scroll(&mut self, coord: Coordinate, content: String) -> bool { :: Write content to a scroll at the given coordinate. If the coordinate already exists (in mmap or overlay), it's modified. If it's new, it's inserted.  Binary-scroll guard: a well-formed binary scroll (an image, say) cannot be replaced through the text path — its stored form is a header plus base64, and a text edit would corrupt the payload silently. Returns false when the write is refused for that reason; the scroll is left exactly as it was. Writing the identical stored form back is a no-op success. Byte payloads go through `write_binary` / `write_bytes` instead. :: doc comment
item+ function src/mmap.rs :: write_scroll_raw :: pub fn write_scroll_raw(&mut self, coord: Coordinate, content: String) { :: Store a scroll's stored form verbatim, with no binary guard. This is the byte path: callers pass either canonical binary scrolls (from `libphext::binary::encode_scroll`) or stored forms they have already validated. Prefer `write_scroll` for text and `write_binary` / `write_bytes` for payloads. :: doc comment
