item+ struct src/term_index.rs :: TermHit :: pub struct TermHit { :: A ranked hit: the document coordinate and its BM25 score. :: doc comment
item+ struct src/term_index.rs :: TermIndex :: pub struct TermIndex { :: Inverted index over lattice documents with BM25 ranking. :: doc comment
item+ function src/term_index.rs :: TermIndex::new :: pub fn new(params: Bm25Params) -> TermIndex { :: An empty index. :: doc comment
item+ function src/term_index.rs :: build :: pub fn build(lattice: &MappedLattice) -> TermIndex { :: Index every populated scroll as its own document (overlay edits included). :: doc comment
item+ function src/term_index.rs :: build_grouped :: pub fn build_grouped<F>(lattice: &MappedLattice, group: F) -> TermIndex where F: Fn(&Coordinate) -> Option<Coordinate> + Sync, { :: Index scrolls grouped into documents: `group` maps a scroll coordinate to the coordinate of the document it belongs to, or `None` to leave it out. Tokenization runs in parallel; documents keep document order. :: doc comment
item+ function src/term_index.rs :: doc_count :: pub fn doc_count(&self) -> usize { :: Number of live documents. :: doc comment
