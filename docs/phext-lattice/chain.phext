item+ function src/mmap.rs :: MappedLattice::open :: pub fn open<P: AsRef<Path>>(path: P) -> io::Result<MappedLattice> { :: Open a phext file and build the lattice index. :: doc comment :: 160 :: 1
item+ function src/mmap.rs :: delete_scroll :: pub fn delete_scroll(&mut self, coord: Coordinate) { :: Delete a scroll at the given coordinate. :: doc comment :: 405 :: 1
item+ function src/mmap.rs :: fetch_binary :: pub fn fetch_binary(&self, coord: &Coordinate) -> Vec<u8> { :: The payload a fetch of this scroll returns, mirroring `libphext::binary::fetch_binary` exactly: a well-formed binary scroll decodes to its payload; any other scroll (plain text, malformed binary, unoccupied) yields its own stored bytes verbatim — empty when the coordinate holds no scroll. Total: never fails, never panics. :: doc comment :: 269 :: 1
item+ function src/mmap.rs :: from_bytes :: pub fn from_bytes(bytes: &[u8]) -> MappedLattice { :: Create a MappedLattice from raw bytes (for testing or in-memory use).  The bytes are written under `std::env::temp_dir()` (never a hard-coded `/tmp`) and mapped from that same file handle. The temp directory is created if it is missing. :: doc comment :: 215 :: 1
item+ function src/mmap.rs :: has_scroll :: pub fn has_scroll(&self, coord: &Coordinate) -> bool { :: Check if a coordinate has content (considering overlay). :: doc comment :: 415 :: 1
item+ function src/mmap.rs :: index :: pub fn index(&self) -> &LatticeIndex { :: Access the underlying index for navigation queries. :: doc comment :: 655 :: 1
item+ function src/mmap.rs :: is_chain :: pub fn is_chain(&self) -> bool { :: True when this file is a chain: more structure than a plain phext's single unclosed member. :: doc comment :: 283 :: 1
item+ function src/mmap.rs :: is_dirty :: pub fn is_dirty(&self) -> bool { :: Check if there are unsaved modifications. :: doc comment :: 449 :: 1
item+ function src/mmap.rs :: member_stats :: pub fn member_stats(&self) -> Vec<(usize, usize)> { :: Per-universe (scroll count, content bytes), in universe order. :: doc comment :: 299 :: 1
item+ function src/mmap.rs :: open_with_index :: pub fn open_with_index<P: AsRef<Path>>(path: P, index: LatticeIndex) -> io::Result<MappedLattice> { :: Open a phext file with an index built elsewhere (e.g. loaded from a `sidecar`), skipping the O(n) scan. Fails if the index was built for a buffer of a different length. A chain-class file ignores the supplied index — a persisted span table describes one universe, not a chain — and is opened with a fresh scan instead. :: doc comment :: 184 :: 1
item+ function src/mmap.rs :: path :: pub fn path(&self) -> &Path { :: Get the file path. :: doc comment :: 660 :: 1
item+ function src/mmap.rs :: pending_changes :: pub fn pending_changes(&self) -> usize { :: Number of modified/inserted/deleted scrolls. :: doc comment :: 454 :: 1
item+ function src/mmap.rs :: pending_coordinates :: pub fn pending_coordinates(&self) -> Vec<Coordinate> { :: Coordinates with unsaved edits (modified, inserted, or deleted), sorted. :: doc comment :: 459 :: 1
item+ function src/mmap.rs :: populated_coordinates :: pub fn populated_coordinates(&self) -> Vec<Coordinate> { :: Get all populated coordinates, including overlay insertions, excluding overlay deletions. Returned in sorted order. :: doc comment :: 424 :: 1
item+ function src/mmap.rs :: raw_buffer :: pub fn raw_buffer(&self) -> Option<&[u8]> { :: Access the raw mmap buffer for search operations. Returns None if overlay has modifications (use to_phext_bytes instead). :: doc comment :: 646 :: 1
item+ function src/mmap.rs :: read_scroll :: pub fn read_scroll(&self, coord: &Coordinate) -> Option<String> { :: Read the content of a scroll at the given coordinate. Returns the overlay version if edited, otherwise reads from mmap. :: doc comment :: 224 :: 1
item+ function src/mmap.rs :: read_scroll_bytes :: pub fn read_scroll_bytes(&self, coord: &Coordinate) -> Option<Vec<u8>> { :: The scroll's exact stored bytes: the overlay version if edited, otherwise the mmap span, uninterpreted. This is the raw layer the binary-scroll support is built on — a binary scroll's stored form is text (header + base64), but payloads are recovered from these bytes without any lossy conversion. :: doc comment :: 249 :: 1
item+ function src/mmap.rs :: read_scroll_bytes_in :: pub fn read_scroll_bytes_in(&self, universe: usize, coord: &Coordinate) -> Option<Vec<u8>> { :: A scroll's exact stored bytes in `universe` (numbered from 1), without switching the active universe. The overlay applies only when `universe` is the active one. :: doc comment :: 336 :: 1
item+ function src/mmap.rs :: read_scroll_in :: pub fn read_scroll_in(&self, universe: usize, coord: &Coordinate) -> Option<String> { :: A scroll's content in `universe` (numbered from 1), without switching the active universe. :: doc comment :: 347 :: 1
item+ function src/mmap.rs :: revert :: pub fn revert(&mut self) { :: Discard all unsaved changes, reverting to the mmap state. :: doc comment :: 665 :: 1
item+ function src/mmap.rs :: save :: pub fn save(&mut self) -> io::Result<()> { :: Save to the backing file. Reconstructs the phext from mmap + overlay. Uses atomic rename via NamedTempFile to prevent partial-write corruption. :: doc comment :: 467 :: 1
item+ function src/mmap.rs :: save_as :: pub fn save_as<P: AsRef<Path>>(&mut self, path: P) -> io::Result<()> { :: Save to a specific path. :: doc comment :: 561 :: 1
item+ function src/mmap.rs :: scroll_count :: pub fn scroll_count(&self) -> usize { :: Number of populated scrolls (considering overlay). :: doc comment :: 444 :: 1
item+ function src/mmap.rs :: set_universe :: pub fn set_universe(&mut self, universe: usize) -> io::Result<()> { :: Make `universe` (numbered from 1) the active universe. Refused while the overlay holds unsaved edits — an edit never straddles a switch — and when the universe is out of range. :: doc comment :: 310 :: 1
item+ function src/mmap.rs :: to_phext_bytes :: pub fn to_phext_bytes(&self) -> Vec<u8> { :: Reconstruct the full phext as bytes from mmap + overlay. :: doc comment :: 567 :: 1
item+ function src/mmap.rs :: universe :: pub fn universe(&self) -> usize { :: The active universe, numbered from 1. :: doc comment :: 294 :: 1
item+ function src/mmap.rs :: universe_count :: pub fn universe_count(&self) -> usize { :: How many universes (member phexts) this file holds. A plain phext holds exactly one. :: doc comment :: 289 :: 1
item+ function src/mmap.rs :: write_binary :: pub fn write_binary(&mut self, coord: Coordinate, payload: &[u8]) { :: Store `payload` at `coord` as a canonical binary scroll (header + base64 of the exact bytes), whatever the payload holds. :: doc comment :: 388 :: 1
item+ function src/mmap.rs :: write_bytes :: pub fn write_bytes(&mut self, coord: Coordinate, payload: &[u8]) { :: Store `payload` at `coord` under the format's ingestion rule (libphext's `stored_form`, behind `insert_bytes`/`replace_bytes`): valid UTF-8 is stored as ordinary text; anything else becomes a binary scroll holding the exact bytes. Ingestion never rejects a payload. :: doc comment :: 397 :: 1
item+ function src/mmap.rs :: write_scroll :: pub fn write_scroll(&mut self, coord: Coordinate, content: String) -> bool { :: Write content to a scroll at the given coordinate. If the coordinate already exists (in mmap or overlay), it's modified. If it's new, it's inserted.  Binary-scroll guard: a well-formed binary scroll (an image, say) cannot be replaced through the text path — its stored form is a header plus base64, and a text edit would corrupt the payload silently. Returns false when the write is refused for that reason; the scroll is left exactly as it was. Writing the identical stored form back is a no-op success. Byte payloads go through `write_binary` / `write_bytes` instead. :: doc comment :: 363 :: 1
item+ function src/mmap.rs :: write_scroll_raw :: pub fn write_scroll_raw(&mut self, coord: Coordinate, content: String) { :: Store a scroll's stored form verbatim, with no binary guard. This is the byte path: callers pass either canonical binary scrolls (from `libphext::binary::encode_scroll`) or stored forms they have already validated. Prefer `write_scroll` for text and `write_binary` / `write_bytes` for payloads. :: doc comment :: 378 :: 1
item+ struct src/mmap.rs :: MappedLattice :: pub struct MappedLattice { :: A memory-mapped phext document with copy-on-write editing.  The document may be a chain (a multiverse): several member phexts — universes — in one file. All read/write methods operate on the *active* universe (see `universe` / `set_universe`); a plain phext is a chain of one universe and behaves exactly as it always has. :: doc comment :: 109 :: 1
