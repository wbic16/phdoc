item~ struct src/oauth.rs :: Editors :: pub struct Editors { :: Accounts allowed to use the editor once signed in. The list starts from `PHEXT_EDITORS` (the operator's bootstrap list) and can grow at runtime: when an editor accepts a submission, the originator's account is admitted — appended here and, when a backing file is configured (see `Gate::load_editors_file`), to that file, so the admission takes effect immediately and survives restarts. Entries sit behind a lock because admission happens through `&Gate` while other requests are reading the list. :: direct :: api
item+ function src/oauth.rs :: Editors::admit :: pub fn admit(&self, who: &str, email: &str) -> bool { :: Admit an account: add its account id (when valid) and its email (when usable), unless each is already covered, and append the new entries to the backing file when one is configured. Takes effect immediately. Returns true when the account is an editor afterwards. :: direct :: api
item+ function src/oauth.rs :: Editors::load_file :: pub fn load_file(&self, path: &std::path::Path) -> usize { :: Point the list at its backing file and load any entries already in it (one per line; blank lines and `#` comments are ignored, and a line may still carry several comma-separated entries). Entries the list already has are not duplicated. Returns how many were loaded. :: direct :: api
item+ function src/oauth.rs :: Gate::admit_account :: pub fn admit_account(&self, who: &str, email: &str) -> bool { :: Admit an account as an editor, effective immediately and persisted to the editors file when one is configured. Used when an editor accepts a submission: the originator joins the editors. :: direct :: api
item+ function src/oauth.rs :: Gate::is_editor :: pub fn is_editor(&self, session: &Session) -> bool { :: Whether a session belongs to an approved editor. :: direct :: api
item+ function src/oauth.rs :: Gate::load_editors_file :: pub fn load_editors_file(&self, path: &std::path::Path) { :: Load additional editor entries from a file (one per line) and make it the backing file for future admissions. The phext-edit server calls this with its default admitted-editors file when `PHEXT_EDITORS_FILE` is not set. :: direct :: api
item+ function src/oauth.rs :: Gate::session :: pub fn session(&self, headers: &HashMap<String, String>) -> Option<Session> { :: The signed-in session for a request, if any. In `--local` mode this is the synthetic local developer (never for a forwarded request), mirroring `session_view`; otherwise it is the cookie session. :: direct :: api
item+ struct src/submissions.rs :: Submission :: pub struct Submission { :: A data shape named Submission. Its fields are: pub id: String; pub filename: String; pub who: String; pub email: String; pub name: String; pub submitted_at: i64; pub bytes: usize; pub scrolls: usize; pub status: SubmissionStatus; pub decided_by: String; pub decided_at: i64; pub curated_as: String. :: inferred :: api
item+ enum src/submissions.rs :: SubmissionStatus :: pub enum SubmissionStatus { :: A named choice named SubmissionStatus. It is one of: Pending; Accepted; Declined. :: inferred :: api
item+ function src/submissions.rs :: content :: pub fn content(dir: &Path, id: &str) -> Option<Vec<u8>> { :: The uploaded phext bytes for a submission. :: direct :: api
item+ function src/submissions.rs :: count_scrolls :: pub fn count_scrolls(content: &str) -> Option<usize> { :: Count the populated scrolls in a phext text. Wrapped in `catch_unwind`: the text is user input, and a parser panic must become a rejection, never a crashed request. :: direct :: api
item+ function src/submissions.rs :: create :: pub fn create( dir: &Path, filename: &str, who: &str, email: &str, name: &str, content: &str, ) -> Result<Submission, String> { :: Store a new pending submission. Validates the file name and the phext (non-empty, parseable) before anything touches disk. :: direct :: api
item+ function src/submissions.rs :: get :: pub fn get(dir: &Path, id: &str) -> Option<Submission> { :: One submission by id, or None. Ids from the network are validated before they ever become a path. :: direct :: api
item+ function src/submissions.rs :: list :: pub fn list(dir: &Path) -> Vec<Submission> { :: Every submission in the directory, oldest first. Unreadable or malformed entries are skipped, never fatal. :: direct :: api
item+ function src/submissions.rs :: sanitize_filename :: pub fn sanitize_filename(raw: &str) -> Option<String> { :: Reduce an offered file name to a bare, safe `*.phext` name, or None when nothing usable remains. Directory parts are stripped, so `../../notes.phext` is just `notes.phext`. :: direct :: api
