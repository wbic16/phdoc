item+ struct src/search.rs :: SearchHit :: pub struct SearchHit { :: A search hit: coordinate + context around the match. :: direct :: api
item+ function src/search.rs :: build_index_parallel :: pub fn build_index_parallel(buffer: &[u8], chunk_size: usize) -> LatticeIndex { :: Parallel index build — partition the buffer into chunks, scan each for delimiter boundaries, then merge. For very large phexts (>100MB) where the O(n) sequential scan becomes noticeable. Currently unused — sequential build is ~30ms for 4.26 MB which is already below perceptual threshold. Included for future scaling. :: direct :: api
item+ function src/search.rs :: search_coordinates :: pub fn search_coordinates( index: &LatticeIndex, pattern: &str, ) -> Vec<Coordinate> { :: Search for coordinates matching a coordinate pattern string. Supports partial coordinates like "3.3.3" (matches any coordinate where any arm starts with 3.3.3). :: direct :: api
