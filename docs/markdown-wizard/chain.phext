item+ function src/fed.rs :: handle_vault_status :: pub fn handle_vault_status( &self, stream: &mut TcpStream, headers: &Map<String, String>, head_only: bool, ) { :: GET /api/vault — the vault dialog's whole picture. :: doc comment
