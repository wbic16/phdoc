item+ struct src/bibliography.rs :: Entry :: pub struct Entry { :: One bibliography entry, parsed from its scroll. :: direct :: api
item+ function src/bibliography.rs :: Entry::field :: pub fn field(&self, name: &str) -> Option<&str> { :: Look up a field by name (`author`, `title`, `year`, …). :: direct :: api
item+ function src/bibliography.rs :: Entry::parse :: pub fn parse(coordinate: Coordinate, scroll: &str) -> Entry { :: Parse an entry from its scroll text at `coordinate`. :: direct :: api
item+ function src/bibliography.rs :: duplicate_candidates :: pub fn duplicate_candidates(entries: &[Entry]) -> Vec<(Coordinate, Coordinate)> { :: Group likely-duplicate entries for an author's review. Intended mechanism: `libphext::phext::soundex_v1` on author names as a candidate generator only — a phonetic match is a hint for a human, never proof that two entries are the same work. :: direct :: api
item+ const src/document.rs :: BIBLIOGRAPHY :: pub const BIBLIOGRAPHY: usize = 2; :: One bibliography entry per scroll. :: direct :: api
item+ const src/document.rs :: BODY :: pub const BODY: usize = 1; :: Chapters, sections, and content blocks. :: direct :: api
item+ const src/document.rs :: MEDIA :: pub const MEDIA: usize = 3; :: Figures and embedded media payloads. :: direct :: api
item+ const src/document.rs :: METADATA :: pub const METADATA: usize = 6; :: Title, authors, abstract, provenance, checksum manifest. :: direct :: api
item+ struct src/document.rs :: Paper :: pub struct Paper { :: A phextura paper: the corpus text and the coordinate of its root. :: direct :: api
item+ function src/document.rs :: Paper::fetch :: pub fn fetch(&self, coord: Coordinate) -> String { :: Fetch one scroll of the paper by coordinate (`libphext::phext::fetch` is the intended mechanism). :: direct :: api
item+ function src/document.rs :: Paper::load :: pub fn load(corpus: &str) -> Paper { :: Load a paper from imploded phext text (`libphext::phext::explode` is the intended mechanism for working with its scrolls). :: direct :: api
item+ function src/document.rs :: Paper::new :: pub fn new(root: Coordinate) -> Paper { :: Create an empty paper rooted at `root`. Intended behavior: seed the metadata subspace and an empty body. :: direct :: api
item+ const src/document.rs :: STYLES :: pub const STYLES: usize = 4; :: Style scrolls. :: direct :: api
item+ const src/document.rs :: SUPPLEMENTS :: pub const SUPPLEMENTS: usize = 5; :: Embedded documents: data, code, extended proofs. :: direct :: api
item+ struct src/media.rs :: MediaHeader :: pub struct MediaHeader { :: The header of an embedded media item: one scroll in the media division, preceding the payload scrolls it describes. :: direct :: api
item+ enum src/media.rs :: PayloadEncoding :: pub enum PayloadEncoding { :: How a payload's bytes are carried as scroll text. :: direct :: api
item+ function src/media.rs :: verify :: pub fn verify(header: &MediaHeader, payload_text: &str) -> bool { :: Verify a payload against its header checksum before rendering. :: direct :: api
item+ struct src/reference.rs :: DanglingReference :: pub struct DanglingReference { :: One dangling reference found by validation: where it is written, and the coordinate it fails to reach. :: direct :: api
item+ struct src/reference.rs :: Reference :: pub struct Reference { :: A typed cross-reference: the coordinate of the scroll it points at. :: direct :: api
item+ function src/reference.rs :: Reference::parse :: pub fn parse(text: &str) -> Result<Reference, PhextParseError> { :: Parse a reference from its written form in prose. Delegates to `Coordinate`'s `TryFrom` impl, so malformed addresses surface as [`PhextParseError`] — a lint error, not a panic (the 0.5.0 behavior; 0.4.1 panicked here). :: direct :: api
item+ function src/reference.rs :: validate :: pub fn validate(corpus: &str) -> Vec<DanglingReference> { :: Validate every reference in a corpus in one pass. Intended mechanism: build the reference graph with `libphext::phext::navmap`, then `fetch` each target. :: direct :: api
item+ function src/render.rs :: render_html :: pub fn render_html(paper: &Paper) -> String { :: Render a paper to HTML. :: direct :: api
item+ function src/render.rs :: render_print :: pub fn render_print(paper: &Paper) -> Vec<u8> { :: Render a paper to a print-oriented backend (future work; the layout engine is deliberately unspecified in DESIGN.md §10). :: direct :: api
